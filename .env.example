# ─────────────────────────────────────────────────────────────────────────────
#  semperwake — agent configuration
#
#  Copy to .env, edit, then run ./install.sh (it sources .env automatically).
#      cp .env.example .env && $EDITOR .env && ./install.sh
#
#  .env is gitignored. Never commit it — it holds your bot tokens.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity ────────────────────────────────────────────────────────────────
# Everything is named after this: the tmux session, the systemd units, the
# helper commands (<AGENT>-attach, <AGENT>-bootstrap). Keep it short.
AGENT=semp

# Workspace: memory, prompt, scripts, daily ledgers. Default: $HOME/$AGENT
#WORKSPACE=

# tmux session name. Default: $AGENT
#SESSION=

# Runtime state (nudge timestamps, watchdog hashes). Default: /tmp/$AGENT-state
#STATE_DIR=

# Event queue and the cursor the signal filter advances. Defaults:
# /tmp/$AGENT-events.jsonl and /tmp/$AGENT-cursor.txt. Set both only when a
# separate filesystem is needed for persistence or isolation.
#EVENT_JSONL=
#CURSOR_FILE=

# Absolute path to the Claude Code executable. Normally detected from PATH.
#CLAUDE_BIN=


# ── Chat provider ───────────────────────────────────────────────────────────
# Where the agent listens and reports.
#
#   none      Tier 1. No chat integration at all. The agent paces itself with
#             ScheduleWakeup. Zero extra dependencies — nothing but tmux,
#             systemd and python3. Start here if you are unsure.
#   slack     Socket Mode listener. No public URL, no inbound firewall rule.
#   discord   Gateway WebSocket listener. Same deal.
#
# NOT YET IMPLEMENTED, PRs very welcome: teams, matrix, telegram, irc.
# Adding one means writing a single listener that appends normalized JSON
# lines to $EVENT_JSONL — see "The producer contract" in docs/ARCHITECTURE.md.
# Nothing else in the system needs to change; the nudger, the signal filter
# and the watchdog are all provider-agnostic by design.
CHAT_PROVIDER=none


# ── Who may authorise writes ────────────────────────────────────────────────
# THE most important setting here. The agent runs with --dangerously-skip-
# permissions, so this id is the boundary between "reads freely" and "can
# change production". Only this user's messages can authorise a write, and
# only with an explicit confirmation word. See the safety section of your
# BOOTSTRAP-PROMPT.txt.
#
#   slack    your member id, e.g. U01ABCDEFGH  (profile -> ... -> Copy member ID)
#   discord  your user id,   e.g. 123456789012345678  (enable Developer Mode,
#                                                      right-click -> Copy User ID)
OWNER_ID=

# The agent's OWN bot user id. Used to detect @-mentions of itself and to drop
# its own messages from the queue — without this it reads its own output as
# new input and answers itself forever.
#   slack    the bot user id (U...) from your app's OAuth page, NOT the app id
#   discord  the application/bot user id
SELF_BOT_ID=

# Direct-message channel between you and the agent.
#   slack    leave BLANK — resolved automatically via conversations.open
#   discord  leave BLANK — resolved automatically on first DM
OWNER_DM_CHANNEL=

# Where the liveness watchdog posts when it cannot self-heal. Blank = owner DM.
#ALERT_CHANNEL=


# ── What the agent pays attention to ───────────────────────────────────────
# Comma-separated channel ids, no spaces. Everything not listed here is
# treated as firehose and dropped by the signal filter.

# Channels where YOUR messages are instructions (not just the DM).
OWNER_CHANNELS=

# Channels carrying bot/app alerts the agent should triage: CI failures, deploy
# results, monitoring. Bot messages are kept here and dropped everywhere else.
INCIDENT_CHANNELS=


# ── Slack ───────────────────────────────────────────────────────────────────
# Create an app at api.slack.com/apps, then:
#   1. Socket Mode -> enable -> generate an app-level token with
#      connections:write  ->  that is SLACK_APP_TOKEN (xapp-...)
#   2. OAuth & Permissions -> bot scopes: chat:write, channels:history,
#      groups:history, im:history, im:write, users:read, reactions:write
#      -> install to workspace -> Bot User OAuth Token (xoxb-...)
#   3. Event Subscriptions -> subscribe to bot events: message.channels,
#      message.groups, message.im, app_mention
#   4. Invite the bot to every channel in OWNER_CHANNELS / INCIDENT_CHANNELS.
#      A bot that is not in a channel receives nothing and reports silence.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=


# ── Discord ─────────────────────────────────────────────────────────────────
# Create an app at discord.com/developers/applications, then:
#   1. Bot -> Reset Token -> that is DISCORD_BOT_TOKEN
#   2. Bot -> Privileged Gateway Intents -> enable MESSAGE CONTENT INTENT.
#      Without it every message arrives with an EMPTY text field — the agent
#      sees traffic it cannot read, which looks like a parsing bug.
#   3. OAuth2 -> URL Generator -> scopes: bot | permissions: View Channels,
#      Send Messages, Read Message History -> invite it to your server.
DISCORD_BOT_TOKEN=


# ── Pacing and self-healing ────────────────────────────────────────────────
# Pane byte-identical for this long => the loop is frozen => re-arm or restart.
# MUST stay well above the agent's longest idle ScheduleWakeup interval (600s
# in the shipped prompt) or the watchdog will restart a healthy sleeping agent.
IDLE_STALL_SECS=2400

# One burst of events must produce ONE wake. Claude queues keystrokes, so
# without this the agent spends its budget re-waking instead of working.
NUDGE_COOLDOWN_SECONDS=15

# Extra regex of queue lines worth waking for, on top of owner/mention/
# incident detection. Leave blank unless you have a custom producer.
#NUDGE_PATTERN=
