# agent runtime artifacts — never commit these
*.env
agent.env
.env
.env.*
*-events.jsonl
*-cursor.txt

# a filled-in prompt carries your channel IDs and internal scope; keep it local
BOOTSTRAP-PROMPT.local.txt

# test sandboxes
standing-agent-test.*/
__pycache__/
*.pyc

# editors / os
.DS_Store
*.swp
.idea/
.vscode/

# one working directory per agent. These hold private notes and tokens, so only
# the docs and the example profile are public.
/agents/*
!/agents/README.md
!/agents/example/
/agents/example/.run/
/agents/example/config/
/agents/example/memory/
/agents/example/scripts/
/agents/example/BOOTSTRAP-PROMPT.txt
